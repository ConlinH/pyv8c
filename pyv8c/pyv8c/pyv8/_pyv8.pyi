class MicrotaskQueue:
    """显式微任务队列，固定所属 Isolate 和创建线程，可由多个 Context 共享。"""
    def __init__(self, isolate: Isolate) -> None: ...
    def checkpoint(self, timeout: float = 0) -> None: ...
    def close(self) -> None: ...

class Isolate:
    """独立的 V8 Isolate。"""
    def __init__(self) -> None: ...
    def close(self) -> bool: ...
    def context(
        self,
        global_this: Any,
        trace: bool = False,
        ctx_type: Optional[str] = None,
        timeout: Optional[float] = None,
        lazy_factory: Optional[Callable[[str], Any]] = None,
        trace_callback: Optional[Callable[..., Any]] = None,
        traceable: bool = False,
        reuse_global: Optional[JSObject] = None,
        microtask_queue: Optional[MicrotaskQueue] = None,
        trace_scripts: Optional[Tuple[str, ...]] = None,
    ) -> Context: ...
    def gc(self) -> None: ...
    def _foreground_version(self) -> int:
        """Return the process-wide foreground notification version."""
        ...
    def _foreground_wait(self, version: int) -> int:
        """Wait without the GIL until the native notification version changes."""
        ...
    def _foreground_deadline(self) -> float | None:
        """Seconds until this isolate's next foreground task, or None."""
        ...
    def _set_wasm_response_handler(self, handler: Callable[..., Any] | None) -> None: ...
    @property
    def closed(self) -> bool: ...
    @property
    def external_memory(self) -> int: ...
    @property
    def live_v8_handles(self) -> int:
        """Persistent handles this isolate holds; closing is refused while any are live."""
        ...

# 基本类型
class Context:
    """V8 JavaScript执行上下文"""
    def __init__(self, global_this: Any, trace: bool = False, ctx_type: Optional[str] = None, timeout: Optional[float] = None, isolate: Optional[Isolate] = None, lazy_factory: Optional[Callable[[str], Any]] = None, trace_callback: Optional[Callable[..., Any]] = None, traceable: bool = False, reuse_global: Optional[JSObject] = None, microtask_queue: Optional[MicrotaskQueue] = None, trace_scripts: Optional[Tuple[str, ...]] = None, ordered_global: bool = False) -> None:
        """Create a realm.

        *lazy_factory* answers what a name means here: it takes an interface name and
        returns the class, ``(class, {name: spec})`` when the realm holds the overlay
        itself, or ``None`` for a name it does not know.

        *reuse_global* hands this realm the global object of a realm made earlier from
        the same template -- the window a navigation replaces.  Its state is reset and
        only the identity of the object remains, so a page keeps the reference it held.
        """
        ...
    def _wasm_stream_feed(self, session: Any, data: bytes) -> None: ...
    def _wasm_stream_finish(self, session: Any) -> None: ...
    def _wasm_stream_abort(self, session: Any, reason: Any) -> None: ...
    def exec_js(self, program: str | Script, filename: Optional[str] = None, timeout: Optional[float] = None) -> Any:
        """字符串的编译和执行共用一次预算；显式 timeout 覆盖 Context 默认值，继承外层预算。"""
        ...
    @property
    def isolate_id(self) -> int: ...
    @property
    def live_handles(self) -> int:
        """Python wrappers this realm still owns; zero once it has released them."""
        ...
    def heap_statistics(self) -> Dict[str, int]:
        """Bytes of this isolate's heap in use, committed, and its ceiling."""
        ...
    @property
    def heap_terminations(self) -> int:
        """How many crossings were stopped because the heap was full.

        The script that filled the heap ends with JavaScriptTerminated and the
        isolate carries on: the cross that follows it runs normally.
        """
        ...
    def js_obj(self, py_object: Any, /) -> Optional[JSObject]: ...
    def freeze(self, value: Any, /) -> Any:
        """Convert a Python value to V8 and freeze it in this realm."""
        ...
    def expose(self, *objects: Any, **named: Any) -> None:
        """Make every object a global under its ``__name__``, or under the keyword."""
        ...
    def hide_global(self, name: str, /) -> bool:
        """Take an exposed global back out; False when the realm owns no such name."""
        ...
    def install_ordered(self, items: Sequence[Tuple[str, str]], /) -> int:
        """Install (kind, name) pairs on the owner thread.

        Kinds are ``attribute``, ``method``, ``constructor``, ``host`` and
        ``builtin``. Configurable data-property built-ins retain their values
        and descriptors when repositioned; other built-ins stay in place.
        """
        ...
    def install(self, names: Sequence[str], /) -> int:
        """Install each name as a non-enumerable lazy constructor on the global.

        The class behind a name is answered on first access by the realm's
        ``lazy_factory``, so nothing is built for a name no script reads.
        """
        ...
    def define_global(self, name: str, value: Any, attributes: int = 0) -> None:
        """Install one global value with the property attributes named."""
        ...
    def gc(self) -> None: ...
    def close(self) -> None: ...
    def detach(self) -> None:
        """Mark the realm as left behind by a navigation.

        Its objects stay readable -- page scripts hold references into it -- while the
        engine stops building new things inside it, so a failure raised there cannot walk
        back into the realm that replaced it.  Blink's detached global object.
        """
        ...
    @property
    def detached(self) -> bool: ...
    def to_js(self, value: Any, /) -> Any: ...
    def import_handle(self, handle: JSObject | JSValue, /) -> JSObject | JSValue: ...
    def _promise_rejection_state(self, promise: JSObject, action: int) -> Any: ...
    def set_error_hooks(
        self,
        on_uncaught: Optional[Callable[[Any, Any, int, int, Any], Any]] = None,
        on_rejection: Optional[Callable[[str, int, Any, Any], Any]] = None,
    ) -> None: ...
    def enqueue_microtask(self, function: JSFunction, /) -> None: ...
    def _run_foreground_task(self) -> bool:
        """Run at most one ready V8 foreground task; owner thread, outside JS, no checkpoint."""
        ...
    def set_microtask_queue(self, queue: MicrotaskQueue, /) -> None: ...
    def set_deadline(self, seconds: float) -> None: ...
    def begin_operation(self, seconds: float, /) -> int: ...
    def end_operation(self, ticket: int, /) -> None: ...
    def terminate_operation(self, ticket: int, /) -> bool: ...
    def clear_deadline(self) -> None: ...
    def terminate(self) -> None: ...
    @property
    def glob(self) -> JSObject: ...
    @property
    def trace(self) -> bool: ...
    @trace.setter
    def trace(self, enabled: bool) -> None: ...
    @property
    def timeout(self) -> float: ...
    @timeout.setter
    def timeout(self, value: float) -> None: ...

    # 下面的方法实际上操作的是globalThis对象
    def __getattr__(self, name: str) -> Any: ...
    def __setattr__(self, name: str, value: Any) -> None: ...
    # 没有 __getitem__/__setitem__:上下文类型没有装 mapping 槽,名字用属性形式访问
    # 已经足够(ctx["name"] 会抛 TypeError,而不是像过去那样只存在于 stub 里)。

