    def __repr__(self) -> str: ...
    def _get(self, name: Any, /) -> Any: ...
    def _keys(self) -> list[str]: ...
    def _iterator_method(self) -> Any: ...
    def _invoke(self, receiver: Any, /, *args: Any) -> Any: ...
    def _is_array(self) -> bool: ...
    def _host_value(self) -> Any: ...
    def to_python(self) -> Any: ...
    def _bytes(self) -> bytes: ...
    def _buffer_kind(self) -> str | None: ...
    def _is_uint8_array(self) -> bool: ...
    def _array_buffer_view_info(self) -> tuple[str, int] | None: ...
    def _write_buffer_bytes(self, data: bytes, /) -> None: ...
    def freeze(self) -> JSObject:
        """Freeze this object in its owning V8 context and return it."""
        ...
    def _detach_buffer(self) -> None: ...
    def __bytes__(self) -> bytes: ...
    # Read-only zero-copy view of fixed-size storage; resizable storage raises TypeError.
    def _buffer_view(self) -> memoryview:
        """Experimental read-only zero-copy view of fixed-size backing storage.

        Resizable ArrayBuffers, growable SharedArrayBuffers and their views
        raise TypeError; use bytes(value) for a snapshot instead. An existing
        export pins its original fixed range through detach or Context.close;
        it does not automatically become empty when the JS buffer detaches.
        """
        ...
    def _to_string(self) -> str: ...
    def _to_number(self) -> float: ...

