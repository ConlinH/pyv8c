class JSPromise(JSObject):
    """JavaScript Promise的Python封装"""
    def __init__(self, resolve: Optional[Any] = None, reject: Optional[Any] = None) -> None: ...
    def __repr__(self) -> str: ...


class PromiseResolver:
    """A promise's resolver, held from Python: create the promise now, settle it later.

    ``JSPromise`` covers the settled case.  This covers the other half -- a fetch, a timer, a
    worker reply -- where the engine has to keep the resolver and settle it when the work
    finishes.  It enters the realm named by *context* itself, so it does not require an active
    V8 context on the calling thread, and it keeps that context alive for as long as it is
    held.  Once the realm is closed every method raises ``RuntimeError``.
    """
    def __init__(self, context: Context) -> None: ...
    def promise(self) -> JSPromise: ...
    def resolve(self, value: Any = None, /) -> None: ...
    def reject(self, reason: Any = None, /) -> None: ...
    def __repr__(self) -> str: ...

class SerializationWriter:
    """A host object's bytes, written during its ``host_writer`` callback.

    The primitives are V8's own (its varint formats), which is why a host object's payload
    is only readable by the matching reader. Operations are valid only during
    the callback, on its creating thread; later use raises RuntimeError.
    """

    def write_tag(self, tag: int, /) -> None: ...
    def write_uint32(self, value: int, /) -> None: ...
    def write_uint64(self, value: int, /) -> None: ...
    def write_double(self, value: float, /) -> None: ...
    def write_raw_bytes(self, data: bytes, /) -> None: ...


class SerializationReader:
    """A host object's bytes, read during its ``host_reader`` callback.

    Operations outside that callback or on another thread raise RuntimeError.
    """

    def read_tag(self) -> int: ...
    def read_uint32(self) -> int: ...
    def read_uint64(self) -> int: ...
    def read_double(self) -> float: ...
    def read_raw_bytes(self, length: int, /) -> bytes: ...


class Serializer:
    """One realm's structured-clone wire, which is what Chromium's clone is made of.

    The format is V8's, so objects, arrays, ``Map``/``Set``/``Date``/``RegExp``, an ``Error``
    with its name, message, cause and stack, buffers and views, cycles and transferred buffers
    all behave as they do in a browser.  What V8 cannot know is the host: ``host_check`` says
    which objects are the host's, ``host_writer`` writes them and ``host_reader`` builds them
    back in the reading realm (Blink's ``WriteDOMObject``/``ReadDOMObject`` counterpart).

    For a WebAssembly.Module, pass a list as ``wasm_modules`` on serialization and
    the same list on deserialization. Its entries retain V8's compiled modules;
    release them before calling ``shutdown_v8()``.
    """

    def __init__(self, context: Context) -> None: ...
    def serialize(self, value: Any, transfer: Any = (), host_writer: Any = None,
                  host_check: Any = None, wasm_modules: Optional[list[Any]] = None) -> bytes: ...
    def deserialize(self, data: bytes, transfer: Any = (), host_reader: Any = None,
                    wasm_modules: Optional[list[Any]] = None) -> Any: ...


class JSTypeArray(JSObject):
    """JavaScript TypedArray的Python封装

    文档: ``data`` 为列表时按 ``typed`` 建一个新数组；为 ``ArrayBuffer``/``SharedArrayBuffer``
    时在其上建视图，``byte_offset``/``byte_length`` 指定范围（缺省为整段）；为视图时整段接管。
    """
    def __init__(
        self,
        data: Union[List[Union[int, float]], JSObject],
        typed: int,
        byte_offset: Optional[int] = None,
        byte_length: Optional[int] = None,
    ) -> None: ...
    def __repr__(self) -> str: ...


class JSBuffer(JSObject):
    """**实验性**。零拷贝的 V8 缓冲区字节视图（只读 buffer protocol）。

    由 ``JSObject.buffer_view()`` 返回；缓冲区被分离后按当前状态长度变为 0。
    """

class JSValue:
    def _to_string(self) -> str: ...
    def _to_number(self) -> float: ...
    def _to_boolean(self) -> bool: ...


class JSException(BaseException):
    """JavaScript异常的Python封装"""
    @property
    def original(self) -> Any: ...
    @property
    def filename(self) -> str:
        """Where the failing script came from; empty when V8 named no source."""
        ...
    @property
    def line(self) -> int:
        """The 1-based line V8 reported, or 0 when it reported no message."""
        ...
    @property
    def column(self) -> int:
        """The 0-based column V8 reported, or 0 when it reported no message."""
        ...

class JavaScriptTerminated(BaseException):
    """JavaScript执行终止异常"""
    pass

# 单例对象。它们不是 JSObject:NullType/UndefinedType 是各自独立的类型,不继承
# JSObject,所以这里不声明成 JSObject。
Null: Any
Undefined: Any

# 底层原语：包不在 import 时调用它，公开入口是 configure；正常路径由首次使用时自动调用。
def init_v8(icudtl_path: Optional[str] = None, params: Optional[List[str]] = None) -> bool: ...

# 指定下一次启动 V8 使用的 icudtl.dat 与启动参数；只能在首次使用前调用。
def configure(icudtl_path: Optional[str] = None, params: Optional[List[str]] = None) -> bool: ...

# V8 是否已经启动：import 之后、首次使用 Context/Isolate 等之前为 False。
def is_initialized() -> bool: ...

# 永久关闭 V8；仍有活动 Context/JS 对象时会拒绝关闭。不会为了关闭而启动 V8。
def shutdown_v8() -> bool: ...

# 把标记写进类自己的 IdlSpec:接受类(或任何带 __v8_idl_spec__ 的对象),合并标记后
# 回写并返回同一个对象,所以可以直接当装饰器用:@hidden。
def hidden(thing: type, /) -> type: ...

def unconstructable(thing: type, /) -> type: ...

# 直接触发一次 V8 的低内存通知(作用在默认 isolate 上)。
def low_memory_notification() -> None: ...

# Trigger production V8 collection through LowMemoryNotification.
def v8_gc() -> None: ...

# 获取当前v8 Context
def current_context(isolate: Optional[Isolate] = None, /) -> Optional[Context]: ...

# 页面可能看到的错误族：让一个类继承其中一员，realm 就以那个错误报告它；不继承即
# 宿主自身的失败，永不出现在 JS 里。形状不标准的类在自己的类上声明 __v8_error_shape__
# （realm 里的构造器名、构造参数属性、建好后拷贝上去的 (Python 属性, JS 属性) 对）；
# 实例上写 __v8_error_stack__ = False 表示这个错误不带 stack，读回来的错误就是这样。
class JsError(Exception): ...
class JsTypeError(TypeError): ...
class JsRangeError(ValueError): ...
class JsReferenceError(ReferenceError): ...
class JsSyntaxError(SyntaxError): ...
class JsURIError(ValueError): ...
class JsEvalError(Exception): ...
# 继承它表示：一次失败的 legacy 具名/索引写入或删除，在 V8 允许处可以不被抛出。
class JsInterceptorFailure(Exception): ...

# 获取现任v8 Context
def incumbent_context(isolate: Optional[Isolate] = None, /) -> Optional[Context]: ...

# 从给定的构造函数创建一个新的JavaScript对象
def new(constructor: Any, /, *args: Any) -> Any: ...

# v8版本
def v8_version() -> str: ...
