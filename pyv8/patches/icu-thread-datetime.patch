+static bool pyv8_zone_chars_ok(const char* input, int32_t& length) {
+    length = 0;
+    if (input == nullptr) {
+        return false;
+    }
+    for (const char* p = input; *p != 0; ++p) {
+        const unsigned char c = static_cast<unsigned char>(*p);
+        if (c <= 0x20 || c >= 0x7f) {
+            return false;
+        }
+        if (++length >= 128) {
+            return false;
+        }
+    }
+    return length > 0;
+}
 
+// System zone ids only. Etc/UTC and Etc/GMT are published as "UTC", matching V8.
+extern "C" int pyv8_icu_canonicalize_timezone(const char* input, char* output, int output_size) {
+    int32_t length = 0;
+    if (output == nullptr || output_size <= 1 || !pyv8_zone_chars_ok(input, length)) {
+        return -1;
+    }
+    UnicodeString canonical;
+    UErrorCode status = U_ZERO_ERROR;
+    UBool isSystemID = false;
+    TimeZone::getCanonicalID(UnicodeString(input, length, US_INV), canonical, isSystemID, status);
+    if (U_FAILURE(status) || !isSystemID || canonical.isEmpty() || canonical.isBogus()) {
+        return -1;
+    }
+    if (canonical.compare(UNKNOWN_ZONE_ID, UNKNOWN_ZONE_ID_LENGTH) == 0) {
+        return -1;
+    }
+    static const char16_t etc_utc[] = {0x45, 0x74, 0x63, 0x2f, 0x55, 0x54, 0x43, 0}; /* Etc/UTC */
+    static const char16_t etc_gmt[] = {0x45, 0x74, 0x63, 0x2f, 0x47, 0x4d, 0x54, 0}; /* Etc/GMT */
+    static const char16_t utc_id[] = {0x55, 0x54, 0x43, 0}; /* UTC */
+    if (canonical.compare(etc_utc, 7) == 0 || canonical.compare(etc_gmt, 7) == 0 ||
+            canonical.compare(utc_id, 3) == 0) {
+        if (output_size < 4) {
+            return -1;
+        }
+        output[0] = 'U';
+        output[1] = 'T';
+        output[2] = 'C';
+        output[3] = 0;
+        return 0;
+    }
+    const int32_t canon_len = canonical.length();
+    if (canon_len <= 0 || canon_len >= output_size) {
+        return -1;
+    }
+    const char16_t* buf = canonical.getBuffer();
+    for (int32_t i = 0; i < canon_len; ++i) {
+        if (buf[i] < 0x20 || buf[i] >= 0x7f) {
+            return -1;
+        }
+        output[i] = static_cast<char>(buf[i]);
+    }
+    output[canon_len] = 0;
+    return 0;
+}
+
+extern "C" int pyv8_icu_set_thread_timezone(const char* iana) {
+    delete pyv8_thread_zone.zone;
+    pyv8_thread_zone.zone = nullptr;
+    if (iana == nullptr || iana[0] == 0) {
+        return 0;
+    }
+    TimeZone* created = TimeZone::createTimeZone(UnicodeString(iana, -1, US_INV));
+    if (created == nullptr) {
+        return -1;
+    }
+    UnicodeString got;
+    created->getID(got);
+    if (got.isEmpty() || got.compare(UNKNOWN_ZONE_ID, UNKNOWN_ZONE_ID_LENGTH) == 0) {
+        delete created;
+        return -1;
+    }
+    pyv8_thread_zone.zone = created;
+    return 0;
+}
